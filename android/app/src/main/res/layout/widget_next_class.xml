<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_green_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal"><TextView android:includeFontPadding="false" android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="青禾课表" android:textColor="#175C45" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/><TextView android:includeFontPadding="false" android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="match_parent" android:text="刷新" android:contentDescription="刷新课表组件" android:gravity="center" android:textColor="#175C45" android:textSize="12sp"/></LinearLayout>
<TextView android:includeFontPadding="false" android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请先导入课表" android:textSize="12sp" android:textColor="#475A51" android:maxLines="2"/>
<TextView android:includeFontPadding="false" android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#15271D" android:textSize="18sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp"/><TextView android:includeFontPadding="false" android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#15271D" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp"/><TextView android:includeFontPadding="false" android:id="@+id/widget_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#15271D" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp"/><TextView android:includeFontPadding="false" android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#62776B" android:maxLines="1"/></LinearLayout>